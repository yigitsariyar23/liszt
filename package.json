{
  "name": "liszt",
  "productName": "Liszt",
  "version": "0.1.0",
  "private": true,
  "description": "A personal terminal that runs Claude Code sessions in project tabs and split panes",
  "main": "dist/main.js",
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "npm run build && electron .",
    "typecheck": "tsc --noEmit",
    "postinstall": "chmod +x node_modules/node-pty/prebuilds/*/spawn-helper",
    "dist:mac": "npm run build && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac dir --arm64",
    "deploy": "bash scripts/deploy.sh"
  },
  "devDependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.303",
    "@types/node": "^26.6.5",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "marked": "^16.4.2",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "node-pty": "^1.1.0"
  },
  "build": {
    "appId": "local.liszt.terminal",
    "productName": "Liszt",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**",
      "package.json",
      "!node_modules/node-pty/{deps,third_party,src,scripts,typings}/**",
      "!node_modules/node-pty/prebuilds/{win32-*,darwin-x64}/**",
      "!node_modules/node-pty/binding.gyp"
    ],
    "asarUnpack": [
      "node_modules/node-pty/**"
    ],
    "npmRebuild": false,
    "mac": {
      "target": [
        {
          "target": "dir",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.png",
      "identity": "-",
      "hardenedRuntime": false,
      "extendInfo": {
        "NSDesktopFolderUsageDescription": "Liszt runs Claude Code and shells in your project folders.",
        "NSDocumentsFolderUsageDescription": "Liszt runs Claude Code and shells in your project folders.",
        "NSDownloadsFolderUsageDescription": "Liszt runs Claude Code and shells in your project folders."
      }
    }
  }
}
